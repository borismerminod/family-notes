{
  "$schema": "https://opencode.ai/config.json",
  "model": "lmstudio/ornith-1.5-9b",
  "instructions": [".agent/AGENT.md"],
  "compaction": {
    "auto": true
  },
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "ornith-1.5-9b": {
          "name": "Ornith 1.5 9B Q4_K_M (LM Studio)",
          "tool_call": true,
          "options": {
            "thinking_budget_tokens": 2000
          },
          "variants": {
            "rapide": {
              "thinking_budget_tokens": 1
            },
            "moyen": {
              "thinking_budget_tokens": 2000
            },
            "reflechi": {
              "thinking_budget_tokens": 8000
            }
          },
          "limit": {
            "context": 64000,
            "output": 8192
          }
        }
      }
    },
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "gemma-4-26B-A4B-it-QAT-Q4_0": {
          "name": "Gemma 4 26B A4B QAT Q4_0 (local)",
          "limit": {
            "context": 64000,
            "output": 4096
          }
        },
        "gemma-4-12B-it-QAT-Q4_0": {
          "name": "Gemma 4 12B QAT Q4_0 (local)",
          "limit": {
            "context": 64000,
            "output": 4096
          }
        },
        "gemma-4-E2B-it-Q4_K_M": {
          "name": "Gemma 4 E2B QAT Q4_K_M (local)",
          "limit": {
            "context": 64000,
            "output": 4096
          }
        },
        "gemma-4-E4B-it-Q4_K_M": {
          "name": "Gemma 4 E4B QAT Q4_K_M (local)",
          "limit": {
            "context": 64000,
            "output": 4096
          }
        }
      }
    }
  }
}
