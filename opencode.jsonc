{
  "$schema": "https://opencode.ai/config.json",
  "model": "llamacpp/gemma-4-e4b",
  "providers": {
    "llamacpp": {
      "name": "llama.cpp",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "gemma-4-26b": {
          "name": "Gemma 4 26B A4B QAT Q4_0 (local)",
          "modelID": "gemma-4-26B-A4B-it-QAT-Q4_0",
          "limit": {
            "context": 64000,
            "output": 4096
          }
        },
        "gemma-4-12b": {
          "name": "Gemma 4 12B QAT Q4_0 (local)",
          "modelID": "gemma-4-12B-it-QAT-Q4_0",
          "limit": {
            "context": 64000,
            "output": 4096
          }
        },
        "gemma-4-e2b": {
          "name": "Gemma 4 E2B QAT Q4_K_M (local)",
          "modelID": "gemma-4-E2B-it-Q4_K_M",
          "limit": {
            "context": 64000,
            "output": 4096
          }
        }, 
        "gemma-4-e4b": {
          "name": "Gemma 4 E4B QAT Q4_K_M (local)",
          "modelID": "gemma-4-E4B-it-Q4_K_M",
          "limit": {
            "context": 64000,
            "output": 4096
          }
        }
      }
    }
  }
}
